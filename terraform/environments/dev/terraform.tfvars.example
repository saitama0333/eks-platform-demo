# Copy to terraform.tfvars and replace the public API CIDR with your current
# workstation/VPN public egress IP in CIDR notation (usually x.x.x.x/32).
aws_account_id                        = "829647177071"
cluster_endpoint_public_access_cidrs = ["58.84.61.197/32"]
velero_bucket_name                   = "tf-gitops-nikhil"
velero_prefix                        = "backup/dev"

# Keep true only if dev is the first environment to create the account provider.
# If QA creates it first, set false and copy QA's github_oidc_provider_arn output.

create_github_oidc_provider = true
github_oidc_provider_arn    = null

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "eu-central-1a",
  "eu-central-1b",
  "eu-central-1c"
]

public_subnet_cidrs = [
  "10.0.0.0/20",
  "10.0.16.0/20",
  "10.0.32.0/20"
]

private_subnet_cidrs = [
  "10.0.48.0/20",
  "10.0.64.0/20",
  "10.0.80.0/20"
]

single_nat_gateway = true

cluster_version     = "1.33"
node_instance_types = ["t3.large"]
node_min_size       = 1
node_max_size       = 2
node_desired_size   = 2
node_disk_size      = 10
